<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Version>1.2.1.0</Version>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>PlayFlowMIDI.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="PlayFlowMIDI.ico" />
    <Content Include="THIRD-PARTY-NOTICES.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Melanchall.DryWetMidi" Version="8.0.3" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="PlayFlowMIDI.ico" />
  </ItemGroup>

  <Target Name="BuildBackgroundInjection" BeforeTargets="Build">
    <MSBuild Projects="..\PlayFlowMIDI.Injector\PlayFlowMIDI.Injector.csproj" Targets="Build" Properties="Configuration=$(Configuration)" />
    <MSBuild Projects="..\PlayFlowMIDI.BackgroundHook\PlayFlowMIDI.BackgroundHook.csproj" Targets="Build" Properties="Configuration=$(Configuration)" />
  </Target>

  <Target Name="CopyBackgroundInjection" AfterTargets="Build">
    <ItemGroup>
      <InjectionFiles Include="..\PlayFlowMIDI.Injector\bin\$(Configuration)\net48\**\*.*" />
      <InjectionFiles Include="..\PlayFlowMIDI.BackgroundHook\bin\$(Configuration)\net48\PlayFlowMIDI.BackgroundHook.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(InjectionFiles)" DestinationFolder="$(OutputPath)" SkipUnchangedFiles="true" />
  </Target>

  <Target Name="ZipRelease" AfterTargets="CopyBackgroundInjection" Condition="'$(Configuration)' == 'Release'">
    <ZipDirectory
      SourceDirectory="$(OutputPath)"
      DestinationFile="$(OutputPath)..\PlayFlowMIDI-v$(Version).zip"
      Overwrite="true" />
  </Target>

</Project>
